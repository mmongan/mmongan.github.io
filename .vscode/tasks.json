		},
		{
			"label": "start webpack dev server",
			"type": "shell",
			"command": "npm start",
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "start webpack dev server",
			"type": "shell",
			"command": "npm start",
			"problemMatcher": [],
			"group": "build"
		}
	]
}